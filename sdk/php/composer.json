{
  "name": "pdf-validation-portal/sdk",
  "description": "PHP client for the PDF Validation Portal API",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "guzzlehttp/guzzle": "^7.9"
  },
  "autoload": {
    "psr-4": { "PdfValidation\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "PdfValidation\\Tests\\": "tests/" }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "scripts": {
    "test": "phpunit",
    "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l"
  }
}
